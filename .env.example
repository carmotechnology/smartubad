# ---------------------------------------------------------------------------
# Smartubad — environment variables
# Copy to `.env.local` and fill in. NEVER commit real values.
# The Supabase project is created and managed manually by the project owner.
# ---------------------------------------------------------------------------

# --- Supabase (from Project Settings -> API) -------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# New-style publishable key (`sb_publishable_...`) — preferred.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
# Legacy anon JWT — used as a fallback if the publishable key is absent.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-only. Bypasses RLS — used exclusively for invite acceptance,
# super-admin operations and the seed script. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Direct Postgres connection (seed script / migrations / future ORM) -----
# Use the POOLER connection string (pgbouncer, transaction mode, port 6543)
# because Vercel serverless functions exhaust direct Postgres connections.
# Project Settings -> Database -> Connection string -> "Transaction pooler".
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session-mode / direct connection (port 5432) — for migrations only.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Smartubad"

# Comma-separated list of platform super-admin emails. An account signing in
# with one of these emails is granted the super_admin role (tenant_id = NULL).
SUPER_ADMIN_EMAILS="you@example.com"

# --- Notifications ---------------------------------------------------------
# Email provider. Leave NOTIFICATIONS_PROVIDER=console in development to log
# messages to stdout instead of sending them.
NOTIFICATIONS_PROVIDER="console"   # console | resend
RESEND_API_KEY=""
NOTIFICATIONS_FROM_EMAIL="Smartubad <noreply@example.com>"

# --- SMS (NOT used in v1 — interface is ready for Hormuud et al.) ----------
SMS_PROVIDER="none"                # none | hormuud
HORMUUD_API_URL=""
HORMUUD_API_USERNAME=""
HORMUUD_API_PASSWORD=""
HORMUUD_SENDER_ID=""

# --- Invites ---------------------------------------------------------------
INVITE_TOKEN_TTL_HOURS="72"

# --- Test-only (used by the cross-tenant RLS test suite) -------------------
# Leave unset to have the isolation tests skip instead of fail.
TEST_SUPABASE_URL=""
TEST_SUPABASE_ANON_KEY=""
TEST_SUPABASE_SERVICE_ROLE_KEY=""
